{
 "format_version": "1.10.0",
 "minecraft:attachable": {
  "description": {
   "identifier": "weed:beer",
   "materials": {
    "default": "entity_alphatest",
    "enchanted": "entity_alphatest_glint"
   },
   "textures": {
    "default": "textures/models/held_items",
    "enchanted": "textures/misc/enchanted_item_glint"
   },
   "geometry": {
    "default": "geometry.weed_held_beer"
   },
   "animations": {
    "hold_fp": "animation.weed.held.hold_first_person",
    "hold_tp": "animation.weed.held.hold_third_person",
    "use_fp": "animation.weed.held.use_first_person",
    "use_tp": "animation.weed.held.use_third_person"
   },
   "scripts": {
    "pre_animation": [
     "v.raise = q.main_hand_item_use_duration > 0 ? math.clamp((q.main_hand_item_max_duration - q.main_hand_item_use_duration) / 6.0, 0, 1) : 0;"
    ],
    "animate": [
     {
      "hold_fp": "c.is_first_person"
     },
     {
      "hold_tp": "!c.is_first_person"
     },
     {
      "use_fp": "c.is_first_person ? v.raise : 0"
     },
     {
      "use_tp": "!c.is_first_person ? v.raise : 0"
     }
    ]
   },
   "render_controllers": [
    "controller.render.item_default"
   ]
  }
 }
}